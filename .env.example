# Connection string for the Postgres instance used by the pipeline and tests.
# Tests create and drop their own schema inside this database.
NETLOG_DATABASE_URL=postgresql://localhost:5432/netlog

# Origins the dashboard is served from, comma separated. Defaults to the
# Next.js dev server on port 3000.
NETLOG_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Streaming mode (docker-compose.stream.yml). All three brokers are listed: a
# client given only the broker that happens to be down cannot reach the
# cluster at all.
NETLOG_KAFKA_BOOTSTRAP=localhost:19092,localhost:19093,localhost:19094
NETLOG_KAFKA_TOPIC=bgl-raw
NETLOG_KAFKA_GROUP=netlog-windows
NETLOG_OPENSEARCH_URL=http://localhost:9200
NETLOG_OPENSEARCH_INDEX=netlog-windows

# Window size, and how far the watermark is held back to tolerate out of order
# arrival. Late events are counted and reported, never dropped silently.
NETLOG_STREAM_WINDOW_SECONDS=60
NETLOG_STREAM_ALLOWED_LATENESS=0
